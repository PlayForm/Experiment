{
	"version": 6,
	"control": {
		"service_name": "lab.control",
		"export": "otlp-grpc",
		"default_enabled": true,
		"authorized_attributes": [
			"lab.campaign_id",
			"lab.experiment_id",
			"lab.mutation_id",
			"lab.job_id",
			"lab.task_id",
			"lab.worker_role",
			"lab.model_cohort_hash",
			"lab.host_id",
			"lab.lease_id",
			"lab.fencing_token",
			"lab.event_id",
			"lab.state_from",
			"lab.state_to",
			"lab.result_code",
			"lab.build_recipe_digest",
			"lab.artifact_digest",
			"lab.queue_depth",
			"lab.event_seq",
			"messaging.system",
			"messaging.operation.type"
		],
		"deny_attributes": [
			"prompt",
			"response",
			"source",
			"patch",
			"secret",
			"private_key",
			"raw_stdout",
			"raw_stderr",
			"command_argv",
			"raw_tool_args",
			"http.request.body"
		],
		"span_names": [
			"lab.command.validate",
			"lab.state.transition",
			"lab.queue.dispatch",
			"lab.worker.lease",
			"lab.supervisor.stage",
			"lab.inference.invoke",
			"lab.worker.output.seal",
			"lab.novelty.check",
			"lab.build.prepare",
			"lab.build.execute",
			"lab.oracle.verify",
			"lab.benchmark.reserve",
			"lab.benchmark.run",
			"lab.evaluation.evaluate",
			"lab.feedback.prepare",
			"lab.pki.issue",
			"lab.pki.revoke",
			"lab.paper.sanitize",
			"lab.publication.review",
			"lab.cas.commit",
			"lab.event.append"
		],
		"metrics": [
			"lab.jobs.queue.depth",
			"lab.jobs.active",
			"lab.leases.held",
			"lab.bench_host.exclusive_occupancy",
			"lab.agent.task_duration",
			"lab.inference.wall_duration",
			"lab.build.wall_duration",
			"lab.oracle.pass_count",
			"lab.oracle.failure_count",
			"lab.benchmark.contamination_count",
			"lab.ledger.append_latency",
			"lab.pki.credentials.issued",
			"lab.pki.credentials.revoked",
			"lab.artifact.bytes_total",
			"lab.telemetry.dropped_spans"
		]
	},
	"product": {
		"service_name": "prun.sut",
		"export": "separate-otlp-grpc",
		"default_enabled": false,
		"modes": ["off", "lite", "diagnostic", "profile"],
		"authoritative_benchmark_mode": "off",
		"allowed_attributes": [
			"lab.experiment_id",
			"lab.mutation_id",
			"lab.sample_id",
			"sut.binary_digest",
			"sut.workload_digest",
			"sut.trace_mode",
			"sut.stage",
			"sut.strategy_id",
			"sut.threads",
			"sut.host_cohort_hash",
			"sut.exit_code"
		],
		"deny_attributes": [
			"child_command",
			"child_argv",
			"input_path",
			"user_home",
			"environment",
			"file_contents",
			"stdout",
			"stderr"
		],
		"span_names": [
			"sut.command.parse",
			"sut.heuristic.analyze",
			"sut.plan.select",
			"sut.walk.discover",
			"sut.glob.match",
			"sut.scheduler.enqueue",
			"sut.process.spawn",
			"sut.process.wait",
			"sut.output.forward",
			"sut.command.total"
		],
		"metrics": [
			"sut.elapsed_ns",
			"sut.cpu_user_ns",
			"sut.cpu_system_ns",
			"sut.peak_rss_bytes",
			"sut.allocated_bytes",
			"sut.minor_faults",
			"sut.major_faults",
			"sut.files_visited",
			"sut.matches",
			"sut.children_spawned",
			"sut.errors"
		]
	},
	"correlation": [
		"lab.campaign_id",
		"lab.experiment_id",
		"lab.mutation_id",
		"sut.binary_digest",
		"sut.workload_digest"
	],
	"privacy": {
		"no_raw_prompt_in_otel": true,
		"no_raw_source_in_otel": true,
		"no_dynamic_filepaths_in_otel": true,
		"trace_context_not_exported_to_llm": true,
		"metadata_identity_separation": true
	}
}
