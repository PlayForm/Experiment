{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.lab.invalid/v6/artifact-manifest.schema.json",
	"title": "artifact-manifest",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"manifest_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"artifacts": {
			"type": "array",
			"items": {
				"$ref": "./artifact-ref.schema.json"
			}
		},
		"root_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"subject_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"manifest_type": {
			"type": "string",
			"enum": [
				"task",
				"build",
				"oracle",
				"benchmark",
				"evidence",
				"research",
				"publication",
				"conversation"
			]
		},
		"created_utc": {
			"type": "string",
			"minLength": 1,
			"format": "date-time"
		}
	},
	"required": [
		"manifest_id",
		"artifacts",
		"root_digest",
		"subject_id",
		"manifest_type",
		"created_utc"
	]
}
