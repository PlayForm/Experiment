{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.lab.invalid/v6/build-request.schema.json",
	"title": "build-request",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"build_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"mutation_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"source_tree_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"toolchain_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"build_recipe_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"dependency_closure_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"features": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			}
		},
		"compiler_flags": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 0
			}
		},
		"target_triple": {
			"type": "string",
			"minLength": 1
		},
		"trace_mode": {
			"type": "string",
			"enum": ["off", "lite", "diagnostic", "profile"]
		},
		"build_container_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"idempotency_key": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		}
	},
	"required": [
		"build_id",
		"mutation_id",
		"source_tree_digest",
		"toolchain_digest",
		"build_recipe_digest",
		"dependency_closure_digest",
		"features",
		"compiler_flags",
		"target_triple",
		"trace_mode",
		"build_container_digest",
		"idempotency_key"
	]
}
