{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.lab.invalid/v6.1/v61-custody-receipt.schema.json",
	"title": "v61-custody-receipt",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"receipt_id": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"request_id": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"decision_id": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"artifact_digest": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"source_holder_id": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"target_holder_id": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"transfer_nonce": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"encrypted_payload_digest": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"verified_plaintext_digest": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"holder_attestation_digest": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"storage_lease_id": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"committed_event_id": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"committed_at": {
			"type": "string",
			"format": "date-time"
		}
	},
	"required": [
		"receipt_id",
		"request_id",
		"decision_id",
		"artifact_digest",
		"source_holder_id",
		"target_holder_id",
		"transfer_nonce",
		"encrypted_payload_digest",
		"verified_plaintext_digest",
		"holder_attestation_digest",
		"storage_lease_id",
		"committed_event_id",
		"committed_at"
	]
}
