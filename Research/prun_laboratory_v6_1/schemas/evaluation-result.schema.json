{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.lab.invalid/v6/evaluation-result.schema.json",
	"title": "evaluation-result",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"evaluation_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"benchmark_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"baseline_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"candidate_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"correctness_attestation_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"performance_attestation_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"effect_elapsed_pct": {
			"type": "number"
		},
		"effect_cpu_pct": {
			"type": "number"
		},
		"effect_peak_rss_pct": {
			"type": "number"
		},
		"confidence_interval_pct": {
			"type": "array",
			"prefixItems": [
				{
					"type": "number"
				},
				{
					"type": "number"
				}
			],
			"minItems": 2,
			"maxItems": 2
		},
		"regression_flags": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			}
		},
		"decision": {
			"type": "string",
			"enum": [
				"eligible",
				"rejected",
				"specialize",
				"more_samples",
				"inconclusive"
			]
		},
		"statistical_protocol_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"evaluated_utc": {
			"type": "string",
			"minLength": 1,
			"format": "date-time"
		}
	},
	"required": [
		"evaluation_id",
		"benchmark_id",
		"baseline_digest",
		"candidate_digest",
		"correctness_attestation_id",
		"performance_attestation_id",
		"effect_elapsed_pct",
		"effect_cpu_pct",
		"effect_peak_rss_pct",
		"confidence_interval_pct",
		"regression_flags",
		"decision",
		"statistical_protocol_digest",
		"evaluated_utc"
	]
}
