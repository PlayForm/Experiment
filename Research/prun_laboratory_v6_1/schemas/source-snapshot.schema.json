{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.lab.invalid/v6/source-snapshot.schema.json",
	"title": "source-snapshot",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"snapshot_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"repository_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"git_commit": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"tree_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"scope_manifest_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"base_snapshot_id": {
			"type": ["string", "null"]
		},
		"license_manifest_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"created_utc": {
			"type": "string",
			"minLength": 1,
			"format": "date-time"
		}
	},
	"required": [
		"snapshot_id",
		"repository_id",
		"git_commit",
		"tree_digest",
		"scope_manifest_digest",
		"base_snapshot_id",
		"license_manifest_digest",
		"created_utc"
	]
}
