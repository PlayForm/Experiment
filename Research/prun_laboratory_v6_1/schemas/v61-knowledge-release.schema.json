{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.lab.invalid/v6.1/v61-knowledge-release.schema.json",
	"title": "v61-knowledge-release",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"release_id": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"origin_repository": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"target_repository": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"source_evidence_digests": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^[a-f0-9]{64}$"
			},
			"maxItems": 1000
		},
		"derived_document_digest": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"sanitization_policy_digest": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"license_grant_ids": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
			},
			"maxItems": 1000
		},
		"embargo_checked": {
			"const": true
		},
		"review_status": {
			"type": "string",
			"enum": ["pending", "authorized", "denied", "published"]
		},
		"release_scope": {
			"type": "string",
			"enum": ["repo-private", "tenant-shared", "public"]
		},
		"exporter_id": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"recorded_at": {
			"type": "string",
			"format": "date-time"
		}
	},
	"required": [
		"release_id",
		"origin_repository",
		"target_repository",
		"source_evidence_digests",
		"derived_document_digest",
		"sanitization_policy_digest",
		"license_grant_ids",
		"embargo_checked",
		"review_status",
		"release_scope",
		"exporter_id",
		"recorded_at"
	]
}
