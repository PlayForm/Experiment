{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.lab.invalid/v6/identity-issuance-request.schema.json",
	"title": "identity-issuance-request",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"subject_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"kind": {
			"type": "string",
			"enum": [
				"x509-tls",
				"ssh-user",
				"ssh-host",
				"message-signing",
				"recipient-encryption"
			]
		},
		"csr_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"requested_scope_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"requested_ttl_seconds": {
			"type": "integer",
			"minimum": 1,
			"maximum": 86400
		},
		"policy_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"request_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		}
	},
	"required": [
		"subject_id",
		"kind",
		"csr_digest",
		"requested_scope_digest",
		"requested_ttl_seconds",
		"policy_digest",
		"request_id"
	]
}
