{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.lab.invalid/v6.1/v61-worker-neutral-receipt.schema.json",
	"title": "v61-worker-neutral-receipt",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"receipt_id": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"task_local_nonce": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"status": {
			"const": "submission_received"
		},
		"receipt_digest": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"visible_message": {
			"const": "Submission received."
		},
		"issued_at": {
			"type": "string",
			"format": "date-time"
		}
	},
	"required": [
		"receipt_id",
		"task_local_nonce",
		"status",
		"receipt_digest",
		"visible_message",
		"issued_at"
	]
}
