{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.lab.invalid/v6/test-plan.schema.json",
	"title": "test-plan",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"test_plan_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"trusted_reference_manifest_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"proposed_changeset_manifest_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"differential_manifest_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"metamorphic_manifest_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"fuzz_manifest_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"compatibility_matrix_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"holdout_partition_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"oracle_image_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"policy_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		}
	},
	"required": [
		"test_plan_id",
		"trusted_reference_manifest_digest",
		"proposed_changeset_manifest_digest",
		"differential_manifest_digest",
		"metamorphic_manifest_digest",
		"fuzz_manifest_digest",
		"compatibility_matrix_digest",
		"holdout_partition_id",
		"oracle_image_digest",
		"policy_digest"
	]
}
