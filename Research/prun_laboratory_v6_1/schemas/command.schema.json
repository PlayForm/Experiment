{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.lab.invalid/v6/command.schema.json",
	"title": "command",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"command_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"command_kind": {
			"type": "string",
			"enum": [
				"activate-campaign",
				"pause-campaign",
				"resume-campaign",
				"drain-campaign",
				"cancel-campaign",
				"replay-events",
				"validate-plan"
			]
		},
		"target_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"desired_revision": {
			"type": "integer",
			"minimum": 0
		},
		"idempotency_key": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"policy_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"reason": {
			"type": "string",
			"minLength": 1
		},
		"submitted_utc": {
			"type": "string",
			"minLength": 1,
			"format": "date-time"
		},
		"operator_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		}
	},
	"required": [
		"command_id",
		"command_kind",
		"target_id",
		"desired_revision",
		"idempotency_key",
		"policy_digest",
		"reason",
		"submitted_utc",
		"operator_id"
	]
}
