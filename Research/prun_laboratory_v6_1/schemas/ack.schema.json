{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.lab.invalid/v6/ack.schema.json",
	"title": "ack",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"request_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"accepted": {
			"type": "boolean"
		},
		"record_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"event_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"state": {
			"type": "string",
			"minLength": 1
		},
		"receipt_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		}
	},
	"required": [
		"request_id",
		"accepted",
		"record_id",
		"event_id",
		"state",
		"receipt_digest"
	]
}
