{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.lab.invalid/v6.1/v61-artifact-policy.schema.json",
	"title": "v61-artifact-policy",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"policy_id": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"artifact_digest": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"origin_repository": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"classification": {
			"type": "string",
			"enum": ["public", "internal", "restricted", "sealed"]
		},
		"custody_scope": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
			},
			"maxItems": 1000
		},
		"permitted_purposes": {
			"type": "array",
			"items": {
				"type": "string",
				"enum": [
					"build",
					"test",
					"benchmark",
					"research",
					"publication",
					"replication",
					"transfer",
					"archive"
				]
			},
			"maxItems": 1000
		},
		"prohibited_derivations": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1,
				"maxLength": 4096
			},
			"maxItems": 1000
		},
		"license_grant_id": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"embargo_rule_ids": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
			},
			"maxItems": 1000
		},
		"disclosure": {
			"type": "string",
			"enum": ["none", "redacted", "full"]
		},
		"retention_seconds": {
			"type": "integer",
			"minimum": 0
		},
		"policy_digest": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"effective_at": {
			"type": "string",
			"format": "date-time"
		}
	},
	"required": [
		"policy_id",
		"artifact_digest",
		"origin_repository",
		"classification",
		"custody_scope",
		"permitted_purposes",
		"license_grant_id",
		"embargo_rule_ids",
		"disclosure",
		"retention_seconds",
		"policy_digest",
		"effective_at"
	]
}
