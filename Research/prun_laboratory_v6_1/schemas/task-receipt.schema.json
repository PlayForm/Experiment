{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.lab.invalid/v6/task-receipt.schema.json",
	"title": "task-receipt",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"task_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"assignment_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"output_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"output_kind": {
			"type": "string",
			"enum": [
				"patch",
				"research-claim",
				"test-proposal",
				"draft-paper",
				"integration-proposal"
			]
		},
		"tool_transcript_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"conversation_manifest_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"worker_image_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"supervisor_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"result_state": {
			"type": "string",
			"enum": ["submitted", "invalid", "timeout", "failed"]
		},
		"completed_utc": {
			"type": "string",
			"minLength": 1,
			"format": "date-time"
		}
	},
	"required": [
		"task_id",
		"assignment_id",
		"output_digest",
		"output_kind",
		"tool_transcript_digest",
		"conversation_manifest_digest",
		"worker_image_digest",
		"supervisor_id",
		"result_state",
		"completed_utc"
	]
}
