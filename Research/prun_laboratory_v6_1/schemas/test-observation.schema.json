{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.lab.invalid/v6/test-observation.schema.json",
	"title": "test-observation",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"test_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"test_family": {
			"type": "string",
			"enum": [
				"reference",
				"changeset",
				"differential",
				"metamorphic",
				"fuzz",
				"compatibility",
				"security",
				"integration"
			]
		},
		"state": {
			"type": "string",
			"enum": ["passed", "failed", "inconclusive", "infrastructure_error"]
		},
		"fixture_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"stdout_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"stderr_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"counterexample_digest": {
			"type": ["string", "null"]
		},
		"duration_ns": {
			"type": "integer",
			"minimum": 0
		},
		"notes_code": {
			"type": "string",
			"minLength": 0
		}
	},
	"required": [
		"test_id",
		"test_family",
		"state",
		"fixture_digest",
		"stdout_digest",
		"stderr_digest",
		"counterexample_digest",
		"duration_ns",
		"notes_code"
	]
}
