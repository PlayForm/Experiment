{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.lab.invalid/v6/task-staging-request.schema.json",
	"title": "task-staging-request",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"bundle": {
			"$ref": "./task-bundle.schema.json"
		},
		"trusted_supervisor_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		},
		"input_digest": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[a-f0-9]{64}$"
		},
		"request_id": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
		}
	},
	"required": [
		"bundle",
		"trusted_supervisor_id",
		"input_digest",
		"request_id"
	]
}
