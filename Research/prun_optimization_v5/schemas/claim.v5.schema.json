{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://example.invalid/prun-lab/claim.v5.schema.json",
	"title": "Prun Research Economy claim v5",
	"type": "object",
	"required": [
		"version",
		"claim_id",
		"case_id",
		"researcher_identity",
		"stance",
		"claim_type",
		"body",
		"confidence",
		"supports",
		"contradicts",
		"evidence_artifact_sha256",
		"source_ref_id",
		"context_snapshot_sha256",
		"registered_utc",
		"signature_b64"
	],
	"properties": {
		"version": {
			"const": 5
		},
		"claim_id": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"case_id": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"researcher_identity": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128
		},
		"stance": {
			"enum": [
				"proponent",
				"skeptic",
				"alternative",
				"replicator",
				"methodologist",
				"librarian"
			]
		},
		"claim_type": {
			"enum": [
				"opinion",
				"hypothesis",
				"external_reference",
				"observation",
				"interpretation",
				"replication"
			]
		},
		"body": {
			"type": "string",
			"minLength": 12
		},
		"confidence": {
			"type": "number",
			"minimum": 0,
			"maximum": 1
		},
		"supports": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1,
				"maxLength": 128
			}
		},
		"contradicts": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1,
				"maxLength": 128
			}
		},
		"evidence_artifact_sha256": {
			"type": ["string", "null"],
			"pattern": "^[a-f0-9]{64}$"
		},
		"source_ref_id": {
			"type": ["string", "null"]
		},
		"context_snapshot_sha256": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"registered_utc": {
			"type": "string",
			"format": "date-time"
		},
		"signature_b64": {
			"type": "string",
			"minLength": 16
		}
	},
	"additionalProperties": false
}
