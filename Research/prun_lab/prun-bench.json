{
	"schema_version": 1,
	"invariants": {
		"builder_base": "rust:slim-bookworm",
		"runner_base": "debian:bookworm-slim",
		"hyperfine_version": "2.0.0",
		"cpuset": "",
		"memory": "4g",
		"warmups": 3,
		"runs": 15,
		"environment": {
			"LC_ALL": "C"
		},
		"metrics": "time_wall_clock,time_cpu,time_user,time_system,memory_peak_resident",
		"runner_cpusets": {}
	},
	"refs": [
		{
			"id": "base",
			"git_ref": "HEAD"
		}
	],
	"builds": [
		{
			"id": "release",
			"profile": "release",
			"rustflags": [],
			"profile_env": {}
		},
		{
			"id": "native",
			"profile": "release",
			"rustflags": ["-Ctarget-cpu=native"],
			"profile_env": {}
		},
		{
			"id": "debug",
			"profile": "dev",
			"rustflags": [],
			"profile_env": {}
		}
	],
	"feature_sets": [
		{
			"id": "default",
			"features": [],
			"no_default_features": false
		}
	],
	"fixtures": [
		{
			"id": "small",
			"directories": 32,
			"depth": 2,
			"noise_files": 3
		},
		{
			"id": "wide",
			"directories": 256,
			"depth": 3,
			"noise_files": 3
		}
	],
	"workloads": [
		{
			"id": "small-serial",
			"fixture": "small",
			"pattern": "bench.marker",
			"parallel": false,
			"command": "/bin/true"
		},
		{
			"id": "small-parallel",
			"fixture": "small",
			"pattern": "bench.marker",
			"parallel": true,
			"command": "/bin/true"
		},
		{
			"id": "wide-serial",
			"fixture": "wide",
			"pattern": "bench.marker",
			"parallel": false,
			"command": "/bin/true"
		},
		{
			"id": "wide-parallel",
			"fixture": "wide",
			"pattern": "bench.marker",
			"parallel": true,
			"command": "/bin/true"
		}
	],
	"exclude": []
}
